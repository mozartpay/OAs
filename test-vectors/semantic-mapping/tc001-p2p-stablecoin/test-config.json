{
  "testId": "tc001-p2p-stablecoin",
  "name": "P2P Stablecoin Payment with ISO 20022 Mapping",
  "description": "Validates that a Stellar-based USDC payment produces correct pacs.008 XML with proper DLT metadata in SupplementaryData",
  "scenario": "p2p-stablecoin",
  "category": "semantic-mapping",
  "dlt": "stellar",
  "asset": "USDC",
  "amount": "100.00",
  "mozartpayCommand": "mozartpay pay send --to GBCDEF... --amount 100 --asset USDC --rail direct --network stellar-testnet --output json",
  "passCriteria": {
    "fieldPresence": ["GrpHdr.MsgId", "CdtTrfTxInf.PmtId.EndToEndId", "CdtTrfTxInf.Amt.InstdAmt"],
    "fieldValues": {
      "CdtTrfTxInf.Amt.InstdAmt.Ccy": "USD",
      "CdtTrfTxInf.Amt.InstdAmt.value": "100.00"
    },
    "supplementaryDataRequired": ["DltAsset", "ComplianceEvidence", "SettlementEvidence"],
    "iso20022Validation": {
      "messageType": "pacs.008.001.08",
      "requiredElements": ["GrpHdr", "CdtTrfTxInf", "SupplementaryData"]
    },
    "passThreshold": 0.8
  },
  "inputFiles": {
    "dlt": "input.dlt.json"
  },
  "expectedFiles": {
    "iso20022": "expected.iso20022.xml",
    "supplementary": "expected.supplementary.json"
  },
  "metadata": {
    "version": "1.0.0",
    "author": "OG Technologies EU",
    "created": "2026-06-01T12:00:00Z",
    "tags": ["stellar", "usdc", "p2p", "iso20022"]
  }
}
