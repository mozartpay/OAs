{
  "testId": "tc201-national-id",
  "name": "National ID Verifiable Credential",
  "description": "Validates issuance and structure of a National ID Verifiable Credential with proper claims",
  "scenario": "national-id",
  "category": "vc-attributes",
  "mozartpayCommand": "mozartpay did attest --method ebsi --vc national-id --name \"Alice Mueller\" --country AT --output json",
  "passCriteria": {
    "fieldPresence": ["@context", "id", "type", "issuer", "issuanceDate", "credentialSubject", "proof"],
    "fieldValues": {
      "type[0]": "VerifiableCredential",
      "type[1]": "NationalIdentityCredential"
    },
    "vcValidation": {
      "requiredClaims": ["sub", "iss", "nationalId"],
      "requiredContexts": ["https://www.w3.org/2018/credentials/v1", "https://w3id.org/ebsi/2024/credentials/v1"],
      "requiredTypes": ["VerifiableCredential", "NationalIdentityCredential"]
    },
    "passThreshold": 0.8
  },
  "inputFiles": {
    "claims": "input.claims.json"
  },
  "expectedFiles": {
    "vc": "expected.vc.jsonld",
    "proof": "expected.proof.jwt"
  },
  "metadata": {
    "version": "1.0.0",
    "author": "OG Technologies EU",
    "created": "2026-06-01T12:00:00Z",
    "tags": ["vc", "national-id", "ebsi", "json-ld"]
  }
}
