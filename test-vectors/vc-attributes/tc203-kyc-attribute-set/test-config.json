{
  "testId": "tc203-kyc-attribute-set",
  "name": "KYC Attribute Set VC",
  "description": "Validates comprehensive KYC attribute set with multiple claims and verification status",
  "scenario": "kyc-attribute-set",
  "category": "vc-attributes",
  "mozartpayCommand": "mozartpay did attest --method ebsi --vc kyc --name \"Charlotte Weber\" --country AT --output json",
  "passCriteria": {
    "fieldPresence": ["@context", "id", "type", "issuer", "issuanceDate", "credentialSubject", "proof"],
    "fieldValues": {
      "type[0]": "VerifiableCredential",
      "type[1]": "KYCCredential"
    },
    "vcValidation": {
      "requiredClaims": ["sub", "iss", "kycLevel", "kycAttributes"],
      "requiredContexts": ["https://www.w3.org/2018/credentials/v1", "https://w3id.org/ebsi/2024/credentials/v1"],
      "requiredTypes": ["VerifiableCredential", "KYCCredential"]
    },
    "passThreshold": 0.8
  },
  "inputFiles": {
    "claims": "input.claims.json"
  },
  "expectedFiles": {
    "vc": "expected.vc.jsonld",
    "proof": "expected.proof.jwt"
  },
  "metadata": {
    "version": "1.0.0",
    "author": "OG Technologies EU",
    "created": "2026-06-01T12:00:00Z",
    "tags": ["vc", "kyc", "attributes", "ebsi"]
  }
}
