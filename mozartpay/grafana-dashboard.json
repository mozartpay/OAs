{
  "dashboard": {
    "id": null,
    "title": "Stellar Arbitrage Scanner",
    "tags": ["stellar", "arbitrage", "trading"],
    "timezone": "browser",
    "schemaVersion": 36,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Profitable Opportunities",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(stellar_arbitrage_is_profitable{network=\"$network\"})",
            "legendFormat": "Profitable Pairs"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "custom": {"displayMode": "basic"}
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Total Pairs Scanned",
        "type": "stat",
        "targets": [
          {
            "expr": "count(stellar_arbitrage_spread_percent{network=\"$network\"})",
            "legendFormat": "Pairs"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Best Spread",
        "type": "stat",
        "targets": [
          {
            "expr": "max(stellar_arbitrage_spread_percent{network=\"$network\"})",
            "legendFormat": "Max Spread %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": -100},
                {"color": "yellow", "value": -0.5},
                {"color": "green", "value": 0}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Last Scan Duration",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(stellar_arbitrage_scan_duration_seconds_sum{network=\"$network\"} / stellar_arbitrage_scan_duration_seconds_count{network=\"$network\"})",
            "legendFormat": "Avg Duration"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s"}
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Arbitrage Spread by Pair",
        "type": "timeseries",
        "targets": [
          {
            "expr": "stellar_arbitrage_spread_percent{network=\"$network\"}",
            "legendFormat": "{{pair}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": -5,
            "max": 5,
            "custom": {"lineWidth": 2, "fillOpacity": 10}
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 6,
        "title": "Net Profit (XLM) by Pair",
        "type": "timeseries",
        "targets": [
          {
            "expr": "stellar_arbitrage_profit_xlm{network=\"$network\"}",
            "legendFormat": "{{pair}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "XLM",
            "custom": {"lineWidth": 2, "fillOpacity": 10}
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 7,
        "title": "Profitability Status",
        "type": "table",
        "targets": [
          {
            "expr": "stellar_arbitrage_is_profitable{network=\"$network\"}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "indexByName": {"pair": 0, "Value": 1},
              "renameByName": {"Value": "Profitable"}
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Profitable"},
              "properties": {
                "mappings": [
                  {"options": {"0": {"text": "No", "color": "red"}}, "type": "value"},
                  {"options": {"1": {"text": "Yes", "color": "green"}}, "type": "value"}
                ]
              }
            }
          ]
        },
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 12}
      },
      {
        "id": 8,
        "title": "Leg Quotes (USDC_XLM)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "stellar_arbitrage_leg_a_quote{network=\"$network\",pair=\"USDC_XLM\"}",
            "legendFormat": "Leg A (XLM→USDC)"
          },
          {
            "expr": "stellar_arbitrage_leg_b_quote{network=\"$network\",pair=\"USDC_XLM\"}",
            "legendFormat": "Leg B (USDC→XLM)"
          }
        ],
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 12}
      },
      {
        "id": 9,
        "title": "Opportunities Found (Total)",
        "type": "stat",
        "targets": [
          {
            "expr": "stellar_arbitrage_opportunities_found_total{network=\"$network\"}",
            "legendFormat": "{{pair}}"
          }
        ],
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 12}
      }
    ],
    "templating": {
      "list": [
        {
          "name": "network",
          "type": "custom",
          "current": {"text": "stellar-mainnet", "value": "stellar-mainnet"},
          "options": [
            {"text": "stellar-mainnet", "value": "stellar-mainnet"},
            {"text": "stellar-testnet", "value": "stellar-testnet"}
          ]
        }
      ]
    },
    "time": {"from": "now-1h", "to": "now"}
  }
}
